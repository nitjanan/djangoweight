# ก๊อปไฟล์นี้เป็น .env แล้วเติมค่าจริง — .env ถูก gitignore ไว้ ห้าม commit
# ค่าจริงห้ามเขียนลง weight/settings.py เด็ดขาด

# Postgres ของระบบ Express (บัญชี/สต๊อก) อ่านอย่างเดียว
# ใช้ดึงบิลเติมน้ำมันของทีมรถร่วม มาคิดราคาน้ำมันเฉลี่ยในหน้า /exportDocument/
# ชุดเดียวกับที่ djangostock ใช้
# ถ้าไม่ตั้ง หน้า export ยังใช้ได้ปกติ แต่ราคาน้ำมันจะถอยไปใช้วิธีเฉลี่ยจากวันที่รถวิ่งแทน
PG_DB_NAME=dbslc
PG_DB_USER=
PG_DB_PASSWORD=
PG_DB_HOST=
PG_DB_PORT=5432

# อีเมลแจ้งเตือน
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
